[Unit]
Description=SMS Daemon Service
After=network.target

[Service]
Type=simple
# It is recommended to run the daemon as its own dedicated user.
# See the "Production Setup" section in README.md for instructions.
User=sms-daemon
Group=sms-daemon

# The recommended installation path for the application.
WorkingDirectory=/opt/sms-daemon/src
ExecStart=/usr/bin/php /opt/sms-daemon/src/sms_daemon.php

# Restart the service if it fails
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
